+int unipi_iio_map_mode_univ(struct iio_dev *indio_dev)
+{
+	struct unipi_iio_device *n_iio = iio_priv(indio_dev);
+	switch(n_iio->mode) {
+		case 1:
+		case 2: return IIO_VOLTAGE;
+		case 3: return IIO_CURRENT;
+		case 4:
+		case 5: return IIO_RESISTANCE;
+	}
+	return -1;
+}
